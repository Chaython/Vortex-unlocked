diff --git a/src/main/src/migrateOfficialData.ts b/src/main/src/migrateOfficialData.ts
new file mode 100644
index 000000000..bb6242ad6
--- /dev/null
+++ b/src/main/src/migrateOfficialData.ts
@@ -0,0 +1,608 @@
+import { execFile } from "node:child_process";
+import { existsSync, type Dirent } from "node:fs";
+import { cp, open, readdir, rm, stat, writeFile } from "node:fs/promises";
+import * as path from "node:path";
+import { promisify } from "node:util";
+
+import { currentStatePath } from "@vortex/shared/state";
+import { app, dialog } from "electron";
+
+import { log } from "./logging";
+import LevelPersist from "./store/LevelPersist";
+
+/**
+ * Vortex Unlocked: import application data from an existing official Vortex
+ * installation.
+ *
+ * Vortex Unlocked stores its data in a separate directory
+ * (%APPDATA%\vortex-unlocked on Windows - Electron derives the user data
+ * path from the packaged application name) so it can be installed and used
+ * side-by-side with the official client (%APPDATA%\Vortex). On first start
+ * this module offers to copy the official data - profiles, mod staging
+ * folders, settings, download metadata - into the Vortex Unlocked directory
+ * so an existing setup carries over without reinstalling anything.
+ *
+ * The import runs before the state database is opened (called from
+ * setupPersistence). Afterwards, absolute paths stored in the database that
+ * point into the old data directory - most importantly the default mod
+ * staging folders at {USERDATA}\{GAME}\mods - are rewritten to the new
+ * location so both installs don't fight over the same files.
+ *
+ * Robustness against files being in use: only Vortex' own data is copied -
+ * electron/chromium runtime files (caches, leveldb storages, crashpad
+ * database) are excluded because a running instance on the source side and
+ * our own electron processes on the destination side keep them open, and
+ * copying over them fails with EBUSY/EPERM. Before anything is written the
+ * source database is probed for locks (a running official client is also
+ * detected via the process list), and file operations are retried a few
+ * times to survive short-lived locks held by antivirus software or the
+ * search indexer.
+ *
+ * The official installation is never modified. Marker files remember a
+ * completed or declined import so the prompt doesn't keep nagging.
+ */
+
+const execFileAsync = promisify(execFile);
+
+/** written after a successful import so the prompt doesn't show again */
+const MARKER_DONE = ".unlocked-import.json";
+/** written when the user picks "Never ask again" */
+const MARKER_DECLINED = ".unlocked-import-declined";
+/** command line flag set by the settings dialog to trigger an import on restart */
+const FORCED_FLAG = "--import-vortex-data";
+/** suffix for the one-generation backup of pre-existing unlocked data */
+const BACKUP_SUFFIX = ".preimport-backup";
+/** number of rewritten state entries written per bulk statement (matches
+ *  upstream's bulkRemoveItem chunk size so statement sizes stay bounded) */
+const BULK_CHUNK = 256;
+
+/**
+ * Top level directories inside a Vortex data directory that are never
+ * copied. "temp", "crashdumps" and "logs" are volatile junk. Everything
+ * else in this set is electron/chromium runtime data: it contains no
+ * Vortex state, it is regenerated as soon as the app runs, and - crucially
+ * for the import - the files inside are held open by the running app, by
+ * the official client on the source side and by our own gpu/network/
+ * crashpad processes on the destination side. Overwriting them mid-copy
+ * fails with EBUSY or EPERM on Windows.
+ * Vortex game ids are never named like any of these.
+ */
+const SKIP_DIRS = new Set([
+  "temp",
+  "crashdumps",
+  "logs",
+  "cache",
+  "code cache",
+  "gpucache",
+  "shadercache",
+  "grshadercache",
+  "graphitedawncache",
+  "dawncache",
+  "dawngraphitecache",
+  "dawnwebgpucache",
+  "blob_storage",
+  "local storage",
+  "indexeddb",
+  "session storage",
+  "webstorage",
+  "service worker",
+  "shared dictionary",
+  "crashpad",
+  "file system",
+  "storage",
+]);
+
+/**
+ * Chromium bookkeeping files directly in the data directory root that are
+ * skipped for the same reason as SKIP_DIRS (held open and rewritten by the
+ * browser process of a running instance; no Vortex state inside).
+ */
+const SKIP_FILES = new Set([
+  "local state",
+  "preferences",
+  "secure preferences",
+  "network persistent state",
+  "cookies",
+  "cookies-journal",
+  "transportsecurity",
+]);
+
+/**
+ * fs error codes that mean a file is (or was just) in use: another process
+ * holding it open, antivirus software scanning it, the search indexer or a
+ * sync tool. They are usually transient, so operations failing with one of
+ * these are retried a few times before the import gives up.
+ */
+const TRANSIENT_ERRNOS = new Set(["EBUSY", "EPERM", "EACCES"]);
+/** delay before retrying a file operation that failed with a lock error */
+const RETRY_DELAYS_MS = [400, 1200, 3000];
+
+/** the import was refused before anything was written because the source
+ *  data is in use - almost always: official Vortex is still running */
+class ImportSourceLockedError extends Error {
+  public constructor(detail: string) {
+    super(detail);
+    this.name = "ImportSourceLockedError";
+  }
+}
+
+function errnoOf(err: unknown): string | undefined {
+  if (err === null || typeof err !== "object") {
+    return undefined;
+  }
+  const code = (err as { code?: unknown }).code;
+  return typeof code === "string" ? code : undefined;
+}
+
+/** runs a file operation, retrying it while the failure looks transient */
+async function withRetry<T>(label: string, op: () => Promise<T>): Promise<T> {
+  let attempt = 0;
+  for (;;) {
+    try {
+      return await op();
+    } catch (err) {
+      const code = errnoOf(err);
+      if (
+        code === undefined
+        || !TRANSIENT_ERRNOS.has(code)
+        || attempt >= RETRY_DELAYS_MS.length
+      ) {
+        throw err;
+      }
+      const delay = RETRY_DELAYS_MS[attempt] ?? 0;
+      attempt += 1;
+      log("warn", `import: ${label} failed with ${code}, retrying in ${delay}ms (attempt ${attempt + 1})`);
+      await new Promise<void>((resolve) => {
+        setTimeout(resolve, delay);
+      });
+    }
+  }
+}
+
+function pathsEqual(a: string, b: string): boolean {
+  const caseSensitive = process.platform === "linux";
+  return caseSensitive ? a === b : a.toLowerCase() === b.toLowerCase();
+}
+
+function escapeRegExp(input: string): string {
+  return input.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+/**
+ * Best effort check whether the official Vortex client is running. Its
+ * executable is "Vortex.exe" (ours is "Vortex Unlocked.exe", which the
+ * exact image name comparison deliberately does not match). Returns null
+ * when the check could not be run; callers then rely on the file lock
+ * probe instead.
+ */
+async function isOfficialVortexRunning(): Promise<boolean | null> {
+  if (process.platform !== "win32") {
+    return null;
+  }
+  try {
+    const { stdout } = await execFileAsync(
+      "tasklist",
+      ["/FI", "IMAGENAME eq Vortex.exe", "/FO", "CSV", "/NH"],
+      { timeout: 8000, windowsHide: true },
+    );
+    return stdout
+      .split(/\r?\n/)
+      .some((line) =>
+        (line.split(",")[0] ?? "").replace(/^"|"$/g, "").toLowerCase() === "vortex.exe",
+      );
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * All files below `root` (recursively; `root` itself may be a plain file).
+ * Unreadable or missing paths yield an empty list - the actual copy will
+ * then surface a proper error message instead.
+ */
+async function collectFiles(root: string): Promise<string[]> {
+  try {
+    const st = await stat(root);
+    if (st.isFile()) {
+      return [root];
+    }
+    if (!st.isDirectory()) {
+      return [];
+    }
+  } catch {
+    return [];
+  }
+  const entries: Dirent[] = await readdir(root, { recursive: true, withFileTypes: true });
+  const files: string[] = [];
+  for (const entry of entries) {
+    if (entry.isFile()) {
+      files.push(path.join(entry.parentPath, entry.name));
+    }
+  }
+  return files;
+}
+
+/**
+ * Pre-flight check: every file that is about to be copied from the state
+ * database is briefly opened for writing and the handle closed again
+ * immediately (nothing is written). If another process - the official
+ * client - holds a database file open without sharing write access, the
+ * open fails and the import is refused with a clear message instead of
+ * dying half way through with EBUSY or, worse, copying a torn write.
+ */
+async function findLockedFiles(files: string[]): Promise<string[]> {
+  const locked: string[] = [];
+  for (const file of files) {
+    try {
+      const handle = await open(file, "r+");
+      await handle.close();
+    } catch (err) {
+      const code = errnoOf(err);
+      if (code !== undefined && TRANSIENT_ERRNOS.has(code)) {
+        locked.push(file);
+      }
+    }
+  }
+  return locked;
+}
+
+interface IRewriteResult {
+  value: string;
+  count: number;
+}
+
+/**
+ * Replaces every occurrence of `from` with `to` inside a value as stored in
+ * the state database (a JSON encoded string). Walks nested structures and
+ * arrays and only reports a change if something actually matched.
+ */
+function rewritePathsInValue(value: string, from: string, to: string): IRewriteResult {
+  let count = 0;
+  const pattern = new RegExp(escapeRegExp(from), process.platform === "linux" ? "g" : "gi");
+
+  const transform = (input: string): string => {
+    const found = input.match(pattern);
+    if (found === null) {
+      return input;
+    }
+    count += found.length;
+    return input.replace(pattern, () => to);
+  };
+
+  const walk = (node: unknown): unknown => {
+    if (typeof node === "string") {
+      return transform(node);
+    } else if (Array.isArray(node)) {
+      return node.map(walk);
+    } else if (node !== null && typeof node === "object") {
+      const out: Record<string, unknown> = {};
+      for (const [key, val] of Object.entries(node)) {
+        out[key] = walk(val);
+      }
+      return out;
+    }
+    return node;
+  };
+
+  try {
+    const result = JSON.stringify(walk(JSON.parse(value)));
+    return { value: result, count };
+  } catch {
+    // not valid json - treat the whole value as one plain string
+    return { value: transform(value), count };
+  }
+}
+
+async function copyTree(source: string, dest: string): Promise<void> {
+  await cp(source, dest, {
+    recursive: true,
+    force: true,
+    // symlinks and junctions are resolved and their content copied as
+    // regular files: creating symlinks can require privileges on windows,
+    // and a link back into the source tree must not silently make both
+    // installs share files
+    dereference: true,
+    filter: (item: string) => {
+      const rel = path.relative(source, item);
+      if (rel === "") {
+        return true;
+      }
+      const parts = rel.split(path.sep);
+      // volatile or runtime-managed subtrees must not be carried over (see
+      // SKIP_DIRS) - notably everything electron/chromium owns
+      const top = (parts[0] ?? "").toLowerCase();
+      if (SKIP_DIRS.has(top)) {
+        return false;
+      }
+      // chromium bookkeeping files directly in the data directory root
+      if (parts.length === 1 && SKIP_FILES.has(top)) {
+        return false;
+      }
+      // log files of the official install are of no use here
+      if (/\.log(\.\d+)?$/.test(path.basename(item).toLowerCase())) {
+        return false;
+      }
+      return true;
+    },
+  });
+}
+
+/**
+ * Rewrites absolute paths inside the (already copied) state database from the
+ * official data directory to the Vortex Unlocked one. Returns the number of
+ * replacements made.
+ */
+async function rewriteStoredPaths(
+  statePath: string,
+  fromDir: string,
+  toDir: string,
+): Promise<number> {
+  const persistor = await LevelPersist.create(statePath);
+  try {
+    const updates: Array<{ key: string[]; value: string }> = [];
+    let replacements = 0;
+    for (const kv of await persistor.getAllKVs()) {
+      const { value, count } = rewritePathsInValue(kv.value, fromDir, toDir);
+      if (count > 0) {
+        updates.push({ key: kv.key, value });
+        replacements += count;
+      }
+    }
+    if (updates.length > 0) {
+      // one transaction, chunked: bulkSetItem emits a single multi-row
+      // INSERT, and rewriting a large state in one statement could exceed
+      // practical statement/parameter sizes (upstream chunks at 256 too)
+      await persistor.beginTransaction();
+      try {
+        for (let i = 0; i < updates.length; i += BULK_CHUNK) {
+          await persistor.bulkSetItem(updates.slice(i, i + BULK_CHUNK));
+        }
+        await persistor.commitTransaction();
+      } catch (err) {
+        await persistor.rollbackTransaction().catch(() => undefined);
+        throw err;
+      }
+    }
+
+    try {
+      const multiUser: unknown = JSON.parse(await persistor.getItem(["user", "multiUser"]));
+      if (multiUser === true) {
+        log(
+          "warn",
+          "the imported data used Vortex' multi-user mode: the shared database is " +
+            "used as-is by both installs and was not migrated",
+        );
+      }
+    } catch {
+      // multi-user flag not present - nothing to report
+    }
+
+    return replacements;
+  } finally {
+    await persistor.close();
+  }
+}
+
+async function runImport(officialDir: string, ourDir: string): Promise<void> {
+  const ourState = path.join(ourDir, currentStatePath);
+  const officialState = path.join(officialDir, currentStatePath);
+  const backupPath = `${ourState}${BACKUP_SUFFIX}`;
+
+  // refuse to import from a database that is currently in use before a
+  // single byte is written. copying a file another process has open either
+  // fails outright (EBUSY/EPERM) or captures a torn write that corrupts the
+  // imported database.
+  const running = await isOfficialVortexRunning();
+  if (running === true) {
+    throw new ImportSourceLockedError(
+      "The official Vortex client is still running (Vortex.exe was found in the process list).",
+    );
+  }
+  const probeTargets = [officialState];
+  const officialWal = `${officialState}.wal`;
+  if (existsSync(officialWal)) {
+    probeTargets.push(officialWal);
+  }
+  const dbFiles: string[] = [];
+  for (const target of probeTargets) {
+    dbFiles.push(...(await collectFiles(target)));
+  }
+  let locked = await findLockedFiles(dbFiles);
+  if (locked.length > 0) {
+    // give a transient lock (antivirus, indexer) a moment to clear before
+    // declaring the source unusable
+    await new Promise<void>((resolve) => {
+      setTimeout(resolve, 400);
+    });
+    locked = await findLockedFiles(locked);
+  }
+  if (locked.length > 0) {
+    const sample = locked.slice(0, 3).map((file) => `  ${file}`).join("\n");
+    throw new ImportSourceLockedError(
+      `The Vortex data at\n  ${officialDir}\nis in use by another program; ` +
+        `these files are locked:\n${sample}` +
+        (locked.length > 3 ? `\n  (and ${locked.length - 3} more)` : ""),
+    );
+  }
+
+  const hadExistingData = existsSync(ourState);
+
+  // back up the current unlocked database so a failed import can be
+  // restored. the state (state.v2) is a directory of database files, so
+  // both the removal of a previous backup and the copy have to be
+  // recursive - copying a directory without { recursive: true } fails
+  // with EISDIR.
+  if (hadExistingData) {
+    await withRetry("remove previous backup", () =>
+      rm(backupPath, { force: true, recursive: true }));
+    await withRetry("back up current data", () =>
+      cp(ourState, backupPath, { recursive: true }));
+  }
+
+  try {
+    // replace the current database wholesale instead of merging into it:
+    // mixing database files from two generations in one directory could
+    // corrupt it. the backup taken above is restored if anything below
+    // goes wrong.
+    await withRetry("remove current state", () =>
+      rm(ourState, { force: true, recursive: true }));
+    // a write-ahead log of the old data must not be replayed over the
+    // imported one
+    await withRetry("remove current state write-ahead log", () =>
+      rm(`${ourState}.wal`, { force: true, recursive: true }));
+
+    await withRetry("copy data", () => copyTree(officialDir, ourDir));
+    const replacements = await rewriteStoredPaths(ourState, officialDir, ourDir);
+    await withRetry("remove import backup", () =>
+      rm(backupPath, { force: true, recursive: true }));
+    await withRetry("write import marker", () =>
+      writeFile(
+        path.join(ourDir, MARKER_DONE),
+        JSON.stringify(
+          {
+            when: new Date().toISOString(),
+            source: officialDir,
+            pathRewrites: replacements,
+          },
+          null,
+          2,
+        ) + "\n",
+      ));
+    log("info", `imported data from ${officialDir} (${replacements} stored paths rewritten)`);
+  } catch (err) {
+    // restore the previous state (if any) so the application can still
+    // start. this must not mask the original error, so restoration
+    // failures are logged and swallowed.
+    try {
+      await withRetry("restore pre-import state", async () => {
+        await rm(ourState, { force: true, recursive: true });
+        await rm(`${ourState}.wal`, { force: true, recursive: true });
+        if (hadExistingData) {
+          await cp(backupPath, ourState, { recursive: true });
+        }
+      });
+    } catch (restoreErr) {
+      log("error", "failed to restore the pre-import state", restoreErr);
+    }
+    throw err;
+  }
+}
+
+function offerImport(officialDir: string, replace: boolean): Promise<number> {
+  return dialog
+    .showMessageBox({
+      type: "question",
+      title: "Vortex Unlocked",
+      message: replace
+        ? "Import data from your Vortex installation again?"
+        : "Import data from your Vortex installation?",
+      detail:
+        `Vortex Unlocked found data of the official Vortex client at\n  ${officialDir}\n\n` +
+        (replace
+          ? "Importing again replaces the data currently used by Vortex Unlocked. " +
+            "A backup of the current data is created first.\n\n"
+          : "") +
+        "This copies profiles, mod staging folders, settings and download metadata " +
+        "into the Vortex Unlocked data directory. The Vortex installation is not " +
+        "modified. Only Vortex' own data is copied; caches and logs are skipped. " +
+        "Please close the official Vortex client while the data is imported. " +
+        "Depending on the size of your mod library this may take a while.",
+      buttons: ["Import", "Not now", "Never ask again"],
+      defaultId: 0,
+      cancelId: 1,
+      noLink: true,
+    })
+    .then((res) => res.response);
+}
+
+/**
+ * Entry point, called from setupPersistence before the state database is
+ * opened for the first time. Prompts (or runs directly when started with
+ * --import-vortex-data, used by the settings dialog) and then imports the
+ * official data, if there is any and the user agrees.
+ */
+export async function maybeImportOfficialVortexData(customUserData: boolean): Promise<void> {
+  try {
+    // never interfere with e2e test runs or unpackaged development builds
+    if (process.env.VORTEX_E2E === "1" || !app.isPackaged) {
+      return;
+    }
+    // a custom --userdata directory means data locations are managed manually
+    if (customUserData) {
+      return;
+    }
+
+    const ourDir = app.getPath("userData");
+    const officialDir = path.join(app.getPath("appData"), "Vortex");
+    if (pathsEqual(ourDir, officialDir)) {
+      return;
+    }
+
+    const officialState = path.join(officialDir, currentStatePath);
+    const forced = process.argv.includes(FORCED_FLAG);
+
+    if (!existsSync(officialState)) {
+      if (forced) {
+        await dialog.showMessageBox({
+          type: "info",
+          title: "Vortex Unlocked",
+          message: "No Vortex data found to import",
+          detail: `No Vortex data was found at\n  ${officialDir}\n\nNothing was changed.`,
+          buttons: ["OK"],
+        });
+      }
+      return;
+    }
+
+    if (!forced) {
+      if (existsSync(path.join(ourDir, MARKER_DONE))) {
+        return;
+      }
+      if (existsSync(path.join(ourDir, MARKER_DECLINED))) {
+        return;
+      }
+      const choice = await offerImport(officialDir, existsSync(path.join(ourDir, currentStatePath)));
+      if (choice === 1) {
+        return;
+      } else if (choice === 2) {
+        await writeFile(path.join(ourDir, MARKER_DECLINED), new Date().toISOString());
+        return;
+      }
+    }
+
+    await runImport(officialDir, ourDir);
+  } catch (err) {
+    if (err instanceof ImportSourceLockedError) {
+      // nothing was changed - the pre-flight check refused the import
+      log("warn", "import aborted, the Vortex data is in use", err.message);
+      await dialog
+        .showMessageBox({
+          type: "warning",
+          title: "Vortex Unlocked",
+          message: "The Vortex data is in use",
+          detail:
+            `${err.message}\n\n` +
+            "Nothing was changed. Close the official Vortex client (and any other " +
+            "program using that folder) and start the import again " +
+            "(Settings - Interface - Import data from Vortex).",
+          buttons: ["OK"],
+        })
+        .catch(() => undefined);
+      return;
+    }
+    log("error", "failed to import data from official Vortex", err);
+    await dialog
+      .showMessageBox({
+        type: "error",
+        title: "Vortex Unlocked",
+        message: "Importing data from Vortex failed",
+        detail:
+          `${err instanceof Error ? err.message : String(err)}\n\n` +
+          "Vortex Unlocked continues with its own data. If the official Vortex " +
+          "client is running, close it and start the import again " +
+          "(Settings - Interface - Import data from Vortex).",
+        buttons: ["OK"],
+      })
+      .catch(() => undefined);
+  }
+}
