new file mode 100644
index 0000000..8a8fb7c
--- /dev/null
+++ b/src/main/src/websiteSession.ts
@@ -0,0 +1,390 @@
+import { BrowserWindow, session } from "electron";
+
+import { betterIpcMain } from "./ipc";
+import { log } from "./logging";
+
+/**
+ * Vortex Unlocked: embedded nexusmods.com website session.
+ *
+ * The Nexus api serves generated download links only to accounts it decides are
+ * entitled to them, but the website will hand a link to any logged-in browser
+ * session ("manual download"). The popular userscript workflow works by calling
+ * the site's link generator from the browser and feeding the keyed link to
+ * Vortex; this module reproduces that round trip inside the client.
+ *
+ * A hidden BrowserWindow shares a persistent session partition with a visible
+ * login window, so the user logs into nexusmods.com once and the generator
+ * window keeps the cookies (including any Cloudflare clearance).
+ *
+ * This talks to an undocumented website endpoint, so it can break whenever the
+ * site changes; every failure falls back to the existing manual download dialog
+ * and is reported as a warning in the log.
+ */
+
+const PARTITION = "persist:nx-web";
+const NEXUS_BASE = "https://www.nexusmods.com";
+const NEXUS_LOGIN_URL = "https://users.nexusmods.com/auth/sign_in";
+const SESSION_PROBE_URL = `${NEXUS_BASE}/users/myaccount`;
+const GENERATE_ENDPOINT = `${NEXUS_BASE}/Core/Libs/Common/Managers/Downloads?GenerateDownloadUrl`;
+
+// free accounts can only generate links at a limited pace; the userscript this
+// mirrors paces its requests too, so stay deliberately slow
+const REQUEST_INTERVAL_MS = 5_000;
+const RETRY_ATTEMPTS = 3;
+const RETRY_DELAY_MS = 2_000;
+// after this many consecutive failed requests, stop trying for a while - likely
+// the site refused the session or the endpoint changed
+const CIRCUIT_BREAK_THRESHOLD = 3;
+const CIRCUIT_BREAK_MS = 10 * 60_000;
+
+/** Wire shape of a generation request, as it crosses IPC from the renderer. */
+interface IGenerateRequest {
+  domain: string;
+  gameId: string;
+  modId: number;
+  fileId: number;
+}
+
+/** What the in-page script returns; executeJavaScript is untyped, so this cast is the boundary. */
+interface IPageGenerateResult {
+  ok: boolean;
+  url?: string;
+  status: number;
+  message?: string;
+}
+
+/** Wire shape of a generation reply. */
+interface IGenerateReply {
+  ok: boolean;
+  nxmUrl?: string;
+  reason?: string;
+}
+
+const delay = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+let generatorWindow: BrowserWindow | null = null;
+let lastRequestAt = 0;
+let consecutiveFailures = 0;
+let circuitOpenUntil = 0;
+// generation is serialized: one request at a time, spaced at least REQUEST_INTERVAL_MS apart
+let queue: Promise<void> = Promise.resolve();
+
+function getSession(): Electron.Session {
+  return session.fromPartition(PARTITION);
+}
+
+async function isLoggedIn(): Promise<boolean> {
+  try {
+    // Probe a page that requires a Nexus website account. Session.fetch uses
+    // the Chromium network stack for this exact persist:nx-web partition, so
+    // this verifies the session that the generator will actually use instead
+    // of guessing at private cookie names.
+    const response = await getSession().fetch(SESSION_PROBE_URL, {
+      method: "GET",
+      redirect: "manual",
+      headers: { Accept: "text/html" },
+    });
+
+    // Logged-out requests are redirected to the users.nexusmods.com sign-in
+    // flow. A successful account page is a 2xx response.
+    return response.status >= 200 && response.status < 300;
+  } catch (err) {
+    log("warn", "failed to verify website login session", { error: String(err) });
+    return false;
+  }
+}
+
+/**
+ * The hidden page the generator runs in. Created lazily on first use and reused;
+ * a plain page fetch from this context is indistinguishable from the userscript
+ * running in a tab - same cookies, same origin, same Cloudflare clearance.
+ */
+async function getGeneratorWindow(): Promise<BrowserWindow> {
+  if (generatorWindow !== null && !generatorWindow.isDestroyed()) {
+    return generatorWindow;
+  }
+
+  const win = new BrowserWindow({
+    show: false,
+    webPreferences: {
+      partition: PARTITION,
+      contextIsolation: true,
+      nodeIntegration: false,
+      backgroundThrottling: false,
+    },
+  });
+
+  try {
+    await win.loadURL(`${NEXUS_BASE}/`);
+  } catch (err) {
+    log("warn", "failed to load the website session generator page", { error: String(err) });
+    if (!win.isDestroyed()) {
+      win.destroy();
+    }
+    throw err;
+  }
+
+  generatorWindow = win;
+  return win;
+}
+
+/** Extract the authorisation params from a generated (website) url and build an nxm link. */
+function buildNxmLink(request: IGenerateRequest, generatedUrl: string): string | undefined {
+  if (generatedUrl.startsWith("nxm://")) {
+    return generatedUrl;
+  }
+  try {
+    const url = new URL(generatedUrl);
+    const key = url.searchParams.get("key") ?? url.searchParams.get("md5");
+    const expires = url.searchParams.get("expires");
+    const userId = url.searchParams.get("user_id");
+    if (key === null || expires === null || userId === null) {
+      return undefined;
+    }
+    const params = new URLSearchParams({ key, expires, user_id: userId });
+    return `nxm://${request.domain}/mods/${request.modId}/files/${request.fileId}?${params.toString()}`;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * One generation attempt inside the page context. Runs as a fetch from the
+ * nexusmods.com origin with the session's cookies, mirroring the userscript.
+ */
+async function generateOnce(
+  win: BrowserWindow,
+  request: IGenerateRequest,
+): Promise<{ ok: boolean; url?: string; status: number; message?: string }> {
+  const script = `(async () => {
+    try {
+      // the userscript clears the ads cookie before generating; harmless here too
+      const expiry = Math.round(Date.now() / 1000) + 300;
+      document.cookie = "ab=0|" + expiry + ";domain=nexusmods.com;path=/";
+      const res = await fetch(${JSON.stringify(GENERATE_ENDPOINT)}, {
+        method: "POST",
+        headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
+        credentials: "include",
+        body: new URLSearchParams({
+          fid: String(${request.fileId}),
+          game_id: String(${JSON.stringify(request.gameId)}),
+        }).toString(),
+      });
+      if (!res.ok) {
+        return { ok: false, status: res.status };
+      }
+      const data = await res.json();
+      const url = (data && typeof data.url === "string") ? data.url : "";
+      return { ok: true, url, status: res.status };
+    } catch (err) {
+      return { ok: false, status: 0, message: String((err && err.message) || err) };
+    }
+  })()`;
+
+  const result = (await win.webContents.executeJavaScript(script, true)) as
+    | IPageGenerateResult
+    | undefined;
+  return {
+    ok: result?.ok === true,
+    url: typeof result?.url === "string" ? result.url : undefined,
+    status: typeof result?.status === "number" ? result.status : 0,
+    message: typeof result?.message === "string" ? result.message : undefined,
+  };
+}
+
+/** A full generation: paced, retried with backoff, circuit-broken. */
+async function generateWithRetries(request: IGenerateRequest): Promise<IGenerateReply> {
+  if (Date.now() < circuitOpenUntil) {
+    return { ok: false, reason: "paused" };
+  }
+
+  const sinceLast = Date.now() - lastRequestAt;
+  if (lastRequestAt > 0 && sinceLast < REQUEST_INTERVAL_MS) {
+    await delay(REQUEST_INTERVAL_MS - sinceLast);
+  }
+
+  let win: BrowserWindow;
+  try {
+    win = await getGeneratorWindow();
+  } catch {
+    return { ok: false, reason: "page unavailable" };
+  }
+
+  for (let attempt = 0; attempt < RETRY_ATTEMPTS; ++attempt) {
+    lastRequestAt = Date.now();
+    if (attempt > 0) {
+      await delay(RETRY_DELAY_MS * Math.pow(2, attempt - 1));
+    }
+
+    let result;
+    try {
+      result = await generateOnce(win, request);
+    } catch (err) {
+      // the page may have been closed or navigated; drop it so the next attempt rebuilds it
+      if (!win.isDestroyed()) {
+        win.destroy();
+      }
+      generatorWindow = null;
+      log("warn", "website link generator page failed", { error: String(err) });
+      result = { ok: false, status: 0, message: String(err) };
+    }
+
+    if (result.ok && typeof result.url === "string" && result.url.length > 0) {
+      const nxmUrl = buildNxmLink(request, result.url);
+      if (nxmUrl !== undefined) {
+        consecutiveFailures = 0;
+        return { ok: true, nxmUrl };
+      }
+      // the endpoint answered without usable auth params - not worth retrying
+      log("warn", "website link response missing authorisation params", {
+        modId: request.modId,
+        fileId: request.fileId,
+      });
+      return { ok: false, reason: "malformed response" };
+    }
+
+    if (result.status === 401 || result.status === 403) {
+      // the session is gone or refused; retrying won't help
+      log("warn", "website link generation refused", {
+        status: result.status,
+        modId: request.modId,
+        fileId: request.fileId,
+      });
+      return { ok: false, reason: "refused" };
+    }
+
+    log("info", "website link generation attempt failed", {
+      attempt,
+      status: result.status,
+      message: result.message,
+    });
+  }
+
+  consecutiveFailures += 1;
+  if (consecutiveFailures >= CIRCUIT_BREAK_THRESHOLD) {
+    circuitOpenUntil = Date.now() + CIRCUIT_BREAK_MS;
+    consecutiveFailures = 0;
+    log("warn", "website link generator circuit broken - pausing auto-authorisation", {
+      minutes: CIRCUIT_BREAK_MS / 60_000,
+    });
+  }
+  return { ok: false, reason: "unavailable" };
+}
+
+/** Serialize requests so they are spaced out no matter how many files queue at once. */
+function enqueueGeneration(request: IGenerateRequest): Promise<IGenerateReply> {
+  const run = queue.then(() => generateWithRetries(request));
+  // the chain must survive failed requests
+  queue = run.then(
+    () => undefined,
+    () => undefined,
+  );
+  return run;
+}
+
+/** Open a visible login window and resolve once the session cookie appears (or the window closes). */
+async function openLogin(): Promise<{ ok: boolean; reason?: string }> {
+  if (await isLoggedIn()) {
+    return { ok: true };
+  }
+
+  const win = new BrowserWindow({
+    show: true,
+    width: 1100,
+    height: 800,
+    title: "Log in to Nexus Mods",
+    webPreferences: {
+      partition: PARTITION,
+      contextIsolation: true,
+      nodeIntegration: false,
+    },
+  });
+
+  try {
+    await win.loadURL(NEXUS_LOGIN_URL);
+  } catch (err) {
+    log("warn", "failed to load the Nexus users login page", { error: String(err) });
+  }
+
+  return new Promise((resolve) => {
+    let settled = false;
+    const finish = (reply: { ok: boolean; reason?: string }): void => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      clearInterval(timer);
+      resolve(reply);
+    };
+
+    const timer = setInterval(() => {
+      if (win.isDestroyed()) {
+        finish({ ok: false, reason: "closed" });
+        return;
+      }
+      void isLoggedIn().then((loggedIn) => {
+        if (loggedIn) {
+          // A generator page created before login may still contain a logged-out
+          // document even though the persistent partition now has valid cookies.
+          // Recreate it on the next request so page state and cookies agree.
+          if (generatorWindow !== null && !generatorWindow.isDestroyed()) {
+            generatorWindow.destroy();
+          }
+          generatorWindow = null;
+
+          if (!win.isDestroyed()) {
+            try {
+              win.close();
+            } catch {
+              // already closing
+            }
+          }
+          finish({ ok: true });
+        }
+      });
+    }, 2_000);
+
+    win.on("closed", () => {
+      void isLoggedIn().then((loggedIn) => finish({ ok: loggedIn, reason: "closed" }));
+    });
+  });
+}
+
+async function logout(): Promise<void> {
+  await getSession().clearStorageData();
+  if (generatorWindow !== null && !generatorWindow.isDestroyed()) {
+    generatorWindow.destroy();
+  }
+  generatorWindow = null;
+}
+
+/** Register the IPC handlers; called once from the Application constructor. */
+export function initWebsiteSession(): void {
+  betterIpcMain.handle("website-session:status", async () => ({
+    loggedIn: await isLoggedIn(),
+  }));
+
+  betterIpcMain.handle("website-session:login", async () => openLogin());
+
+  betterIpcMain.handle("website-session:logout", async () => {
+    await logout();
+  });
+
+  betterIpcMain.handle("website-session:generate", async (_event, request) => {
+    if (
+      request === undefined ||
+      typeof request.modId !== "number" ||
+      typeof request.fileId !== "number" ||
+      typeof request.domain !== "string" ||
+      typeof request.gameId !== "string"
+    ) {
+      return { ok: false, reason: "invalid request" };
+    }
+    if (!(await isLoggedIn())) {
+      return { ok: false, reason: "not logged in" };
+    }
+    return enqueueGeneration(request);
+  });
+
+  log("debug", "website session service initialised");
+}
